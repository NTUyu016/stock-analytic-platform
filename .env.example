# 複製成 .env，不進版控（deployment.md §6：v1 沒有平台原生 secret 機制，統一走 .env）
# ⚠️ .env 本身、以及任何填了真實值的複本，都不得提交或貼進 issue/PR。

DATABASE_URL=postgresql+psycopg://stockapp:stockapp@localhost:5432/stockapp
POSTGRES_USER=stockapp
POSTGRES_PASSWORD=stockapp
POSTGRES_DB=stockapp

# deployment.md §2.4：<機器名>.<tailnet-name>.ts.net，由 `tailscale status` 取得。
# ⚠️ 機器名不得含可識別個人的字串——它會原樣進入公開的 Certificate Transparency log。
TAILSCALE_HOSTNAME=

SESSION_COOKIE_NAME=session_id
SESSION_TTL_DAYS=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# alerts.md：Discord webhook，通知內文不得含金額與百分比
DISCORD_WEBHOOK_URL=

# deployment.md §5：Healthchecks.io 免費層 ping URL，這個值本身是機密
HEALTHCHECKS_PING_URL=

# fake（預設，dev 用重播 tick 檔）/ fugle
QUOTE_PROVIDER=fake
FUGLE_API_KEY=
